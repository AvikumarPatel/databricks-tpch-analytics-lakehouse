{
  "datasets": [
    {
      "name": "e2028410",
      "displayName": "Executive KPIs",
      "queryLines": [
        "SELECT\r\n",
        "    total_orders,\r\n",
        "    total_customers,\r\n",
        "    gross_revenue,\r\n",
        "    total_discount,\r\n",
        "    net_revenue,\r\n",
        "    avg_order_value,\r\n",
        "    avg_shipping_days,\r\n",
        "    late_delivery_rate_pct\r\n",
        "FROM workspace.tpch_gold.executive_kpis;"
      ]
    },
    {
      "name": "e982523a",
      "displayName": "Monthly Revenue",
      "queryLines": [
        "SELECT\r\n",
        "    MAKE_DATE(order_year, order_month, 1) AS month_start,\r\n",
        "    total_orders,\r\n",
        "    unique_customers,\r\n",
        "    net_revenue,\r\n",
        "    avg_order_value\r\n",
        "FROM workspace.tpch_gold.monthly_revenue\r\n",
        "WHERE MAKE_DATE(order_year, order_month, 1) <\r\n",
        "      DATE_TRUNC(\r\n",
        "          'MONTH',\r\n",
        "          (SELECT MAX(order_date)\r\n",
        "           FROM workspace.tpch_silver.orders)\r\n",
        "      )\r\n",
        "ORDER BY month_start;"
      ]
    },
    {
      "name": "481fb8b9",
      "displayName": "Regional Performance",
      "queryLines": [
        "SELECT\r\n",
        "    region,\r\n",
        "    total_orders,\r\n",
        "    customers,\r\n",
        "    net_revenue,\r\n",
        "    avg_order_value,\r\n",
        "    late_delivery_rate_pct\r\n",
        "FROM workspace.tpch_gold.regional_performance\r\n",
        "ORDER BY net_revenue DESC;"
      ]
    },
    {
      "name": "da35b2cf",
      "displayName": "Segment Performance",
      "queryLines": [
        "SELECT\r\n",
        "    market_segment,\r\n",
        "    customers,\r\n",
        "    total_orders,\r\n",
        "    net_revenue,\r\n",
        "    avg_order_value,\r\n",
        "    total_discount\r\n",
        "FROM workspace.tpch_gold.segment_performance\r\n",
        "ORDER BY net_revenue DESC;"
      ]
    },
    {
      "name": "24f86e80",
      "displayName": "Delivery Performance",
      "queryLines": [
        "SELECT\r\n",
        "    region,\r\n",
        "    order_year,\r\n",
        "    total_orders,\r\n",
        "    avg_shipping_days,\r\n",
        "    late_orders,\r\n",
        "    late_delivery_rate_pct\r\n",
        "FROM workspace.tpch_gold.delivery_performance\r\n",
        "ORDER BY order_year, region;"
      ]
    }
  ],
